# ==============================================================================
# Patent Chemistry Analyzer - Environment Configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# All keys are read server-side only; nothing is exposed to the frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Providers (used in priority order)
# The provider chain is auto-detected from whichever keys are present:
#   GROQ > OPENAI > GOOGLE > OLLAMA (local)
# Groq is OpenAI-compatible; no special SDK needed.
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Local Ollama fallback (privacy-preserving; patents stay on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# Chemistry APIs
# ------------------------------------------------------------------------------
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
OPSIN_URL=https://opsin.ch.cam.ac.uk/opsin
NIH_CIR_URL=https://cactus.nci.nih.gov/chemical/structure
CHEBI_API_URL=https://www.ebi.ac.uk/chebi/api
CHEMSPIDER_API_KEY=
NIST_WEBBOOK_URL=https://webbook.nist.gov/cgi/cbook.cgi

# ------------------------------------------------------------------------------
# OCR (Tesseract binary path; empty = auto-detect from PATH)
# ------------------------------------------------------------------------------
TESSERACT_PATH=

# ------------------------------------------------------------------------------
# App / limits
# Leave storage paths unset: the app resolves them to absolute paths under the
# project directory so they work regardless of the working directory.
# ------------------------------------------------------------------------------
MAX_PAGES=150
CORS_ORIGINS=http://localhost:5173
